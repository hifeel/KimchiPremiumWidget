<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- 헤더: 제목 + 시간 + 환율 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌶 김치프리미엄"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp">

            <TextView
                android:id="@+id/tv_update_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textColor="#AAAAAA"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/iv_refresh_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_refresh"
                android:contentDescription="새로고침"
                android:scaleType="centerInside"
                android:visibility="gone"
                android:tint="#FFB74D" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_exchange_rate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="환율: --"
            android:textColor="#FFB74D"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp" />
    </LinearLayout>

    <!-- BTC 행 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="#2A2A4E"
        android:padding="6dp"
        android:layout_marginBottom="3dp">

        <!-- 첫 줄: BTC + 비율 + 차액 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tv_coin1_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BTC"
                android:textColor="#F7931A"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tv_btc_premium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="로딩중"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="차액:"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:layout_marginEnd="2dp" />

            <TextView
                android:id="@+id/tv_btc_diff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₩ --"
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 두 번째 줄: 업비트 / 바이낸스 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="업비트"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_btc_krw"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₩ --"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/tv_coin1_ref_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="바이낸스"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_btc_usd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$ --"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- USDT 행 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="#2A2A4E"
        android:padding="6dp">

        <!-- 첫 줄: USDT + 비율 + 차액 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tv_coin2_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USDT"
                android:textColor="#26A17B"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tv_usdt_premium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="로딩중"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="차액:"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:layout_marginEnd="2dp" />

            <TextView
                android:id="@+id/tv_usdt_diff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₩ --"
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 두 번째 줄: 업비트 / 기준가 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="업비트"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_usdt_krw"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₩ --"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/tv_coin2_ref_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="기준가"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_usdt_usd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₩ --"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
